{
  "version": 2,
  "builds": [
    {
      "src": "/api/lambda.php",
      "use": "vercel-php@0.7.4"
    },
    {
      "src": "/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(css|js|imgs)/(.+)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.+\\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webp))",
      "dest": "/public/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/api/lambda.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://yourapp.vercel.app",
    "VERCEL_DEMO_MODE": "1"
  }
}